# Copy to code/.env or export these variables before running:
#   docker compose -f code/docker-compose.yml up --build

# Optional. If omitted, the backend generates a JWT secret on first packaged launch
# and persists it at DATA_DIR/config.json.
JWT_SECRET=

# Optional runtime overrides.
AUTH_MODE=standard
BACKEND_PORT=5000
HOST_BACKEND_PORT=5000
LOG_LEVEL=Information

# Optional overrides for the Postgres compose variant:
#   docker compose -f code/docker-compose.yml -f code/docker-compose.postgres.yml up --build
POSTGRES_DB=repere
POSTGRES_SUPERUSER=repere_admin
POSTGRES_SUPERUSER_PASSWORD=repere_dev
HOST_POSTGRES_PORT=5432
