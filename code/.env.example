# Copy to code/.env or export these variables before running:
#   docker compose -f code/docker-compose.yml up --build

# Optional. If omitted, the backend generates a JWT secret on first packaged launch
# and persists it at DATA_DIR/config.json.
JWT_SECRET=

# Optional runtime overrides.
AUTH_MODE=standard
BACKEND_PORT=5000
HOST_BACKEND_PORT=5000
LOG_LEVEL=Information

# Optional. Comma-separated IPs or CIDR ranges of reverse proxies whose
# X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host headers the backend may trust
# (for example the compose network the Caddy proxy runs on). Leave empty when the
# backend is exposed directly: forwarded headers are then ignored completely.
# TRUSTED_PROXIES=172.18.0.0/16
TRUSTED_PROXIES=

# Optional reverse proxy settings for the full-stack (Caddy) compose deployment.
# DOMAIN=localhost serves plain HTTP on port 80. Set a public hostname that resolves
# to this machine to switch Caddy to automatic HTTPS (Let's Encrypt); ports 80 and
# 443 must then be reachable from the internet.
# DOMAIN=localhost
# HOST_HTTP_PORT=80
# HOST_HTTPS_PORT=443

# Optional overrides for the Postgres compose variant:
#   docker compose -f code/docker-compose.yml -f code/docker-compose.postgres.yml up --build
POSTGRES_DB=repere
POSTGRES_SUPERUSER=repere_admin
# Required. Replace before first packaged Postgres launch.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
REPERE_SYSTEM_PASSWORD=CHANGE_ME
REPERE_DATA_PASSWORD=CHANGE_ME

# Optional only when you deliberately add code/docker-compose.postgres.expose.yml
# to publish Postgres to the host for direct debugging.
# HOST_POSTGRES_PORT=5432
