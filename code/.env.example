# Copy to code/.env (or export these variables) before starting a packaged stack.
#
# Full stack — proxy + browser UI + backend, the MVP 2 product:
#   docker compose -f code/docker-compose.yml --env-file code/.env up --build
# Backend only — the MVP 1 API shape, backend published on HOST_BACKEND_PORT:
#   docker compose -f code/docker-compose.backend-only.yml --env-file code/.env up --build
# Either base takes the Postgres override as an additional -f file.

# Optional. If omitted, the backend generates a JWT secret on first packaged launch
# and persists it at DATA_DIR/config.json.
JWT_SECRET=

# Optional runtime overrides.
AUTH_MODE=standard
LOG_LEVEL=Information
# Per-client auth rate limits (requests per minute): credential routes (login,
# register, setup) and session routes (refresh, logout; the browser refreshes on
# every page load).
# AUTH_RATE_LIMIT_PER_MINUTE=5
# AUTH_SESSION_RATE_LIMIT_PER_MINUTE=120

# --- Full stack (docker-compose.yml) -------------------------------------------
# DOMAIN=localhost serves plain HTTP on HOST_HTTP_PORT. Set a public hostname that
# resolves to this machine to switch Caddy to automatic HTTPS (Let's Encrypt);
# ports 80 and 443 must then be reachable from the internet.
DOMAIN=localhost
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
# The backend trusts X-Forwarded-* headers from the private address ranges Docker
# allocates compose networks from (10/8, 172.16/12, 192.168/16, fd00::/8). It has
# no host port in this shape, so only stack containers can reach it. Narrow it to
# the proxy's actual network if you publish the backend port yourself:
# TRUSTED_PROXIES=172.18.0.0/16

# --- Backend only (docker-compose.backend-only.yml) ----------------------------
BACKEND_PORT=5000
HOST_BACKEND_PORT=5000
# Optional. Comma-separated IPs or CIDR ranges of reverse proxies whose forwarded
# headers the backend may trust. Leave empty when the backend is exposed directly:
# forwarded headers are then ignored completely. (The full stack sets its own
# default; see above.)
TRUSTED_PROXIES=

# --- Postgres override (docker-compose.postgres.yml) ---------------------------
POSTGRES_DB=bento
POSTGRES_SUPERUSER=bento_admin
# Installs created before the rename to Bento keep their names: POSTGRES_DB=repere,
# POSTGRES_SUPERUSER=repere_admin and the two role names below; the passwords
# formerly named REPERE_SYSTEM_PASSWORD / REPERE_DATA_PASSWORD go below.
# BENTO_SYSTEM_ROLE=repere_system
# BENTO_DATA_ROLE=repere_data
# Required. Replace before first packaged Postgres launch.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
BENTO_SYSTEM_PASSWORD=CHANGE_ME
BENTO_DATA_PASSWORD=CHANGE_ME

# Optional only when you deliberately add code/docker-compose.postgres.expose.yml
# to publish Postgres to the host for direct debugging.
# HOST_POSTGRES_PORT=5432
