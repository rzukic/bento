{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backend": {
    "Port": 5000,
    "LogLevel": "Information",
    "AllowedOrigins": [],
    "MaxBodySize": "10mb",
    "AuthMode": "standard",
    "Jwt": {
      "Issuer": "repere-api",
      "Audience": "repere-clients",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 7
    },
    "AuthCookie": {
      "RefreshCookieName": "repere_refresh",
      "HttpOnly": true,
      "SameSite": "Strict",
      "Path": "/api/v1/auth"
    },
    "AuthRateLimitPerMinute": 5,
    "DataDir": "./data"
  },
  "Database": {
    "Provider": "Sqlite",
    "SystemConnection": "./data",
    "DataConnection": "./data",
    "MinPoolSize": 2,
    "MaxPoolSize": 20,
    "ConnectionTimeoutSeconds": 30
  },
  "Schema": {
    "AutoMigrateOnStartup": false,
    "ModelJsonPath": "./schema/model.json"
  }
}
