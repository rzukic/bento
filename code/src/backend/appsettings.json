{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "SystemConnection": "./data",
    "DataConnection": "./data",
    "MinPoolSize": 2,
    "MaxPoolSize": 20,
    "ConnectionTimeoutSeconds": 30
  }
}
