{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backend": {
    "Port": 5000,
    "LogLevel": "Information",
    "AllowedOrigins": [],
    "MaxBodySize": "10mb",
    "AuthMode": "standard",
    "DataDir": "./data"
  },
  "Database": {
    "Provider": "Sqlite",
    "SystemConnection": "./data",
    "DataConnection": "./data",
    "MinPoolSize": 2,
    "MaxPoolSize": 20,
    "ConnectionTimeoutSeconds": 30
  },
  "Schema": {
    "AutoMigrateOnStartup": false,
    "ModelJsonPath": "./schema/model.json"
  }
}
