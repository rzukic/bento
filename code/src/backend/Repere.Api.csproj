<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- Demo workspace used by the first-run setup wizard (TASK-145). The same files
         feed the packaged smoke scripts so the two cannot drift apart. -->
    <EmbeddedResource Include="..\..\scripts\fixtures\mvp1-demo-schema.json" LogicalName="Repere.Api.SampleData.schema.json" />
    <EmbeddedResource Include="..\..\scripts\fixtures\mvp1-demo-rows.json" LogicalName="Repere.Api.SampleData.rows.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="SqlKata" Version="4.0.1" />
    <PackageReference Include="SqlKata.Execution" Version="4.0.1" />
  </ItemGroup>

</Project>
