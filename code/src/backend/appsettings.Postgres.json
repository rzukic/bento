{
  "Backend": {
    "Port": 5000,
    "LogLevel": "Information",
    "AllowedOrigins": [],
    "MaxBodySize": "10mb",
    "AuthMode": "standard",
    "Jwt": {
      "Issuer": "bento-api",
      "Audience": "bento-clients",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 7
    },
    "AuthCookie": {
      "RefreshCookieName": "bento_refresh",
      "HttpOnly": true,
      "SameSite": "Strict",
      "Path": "/api/v1/auth"
    },
    "AuthRateLimitPerMinute": 5,
    "DataDir": "./data"
  },
  "Database": {
    "Provider": "Postgres",
    "SystemConnection": "Host=localhost;Port=5432;Database=bento;Username=bento_system;Password=CHANGE_ME",
    "DataConnection": "Host=localhost;Port=5432;Database=bento;Username=bento_data;Password=CHANGE_ME"
  },
  "Schema": {
    "AutoMigrateOnStartup": false,
    "ModelJsonPath": "./schema/model.json"
  }
}
