{
  "id": "habits-health",
  "title": "Habits & health",
  "description": "Habits with a goal per week and a log of check-ins, plus measurements — weight, sleep, mood. A dashboard with this week's goals, check-ins per week and weight and sleep over time; two forms, Check in and Log measurement, for the phone.",
  "base": {
    "habits": "habits",
    "habit_log": "habit_log",
    "measurements": "measurements"
  },
  "prefixes": [
    "health_",
    "my_"
  ],
  "tables": [
    {
      "name": "{{habits}}",
      "displayName": "Habits",
      "columns": [
        {
          "name": "id",
          "type": "integer",
          "primaryKey": true
        },
        {
          "name": "name",
          "displayName": "Name",
          "type": "text",
          "nullable": false,
          "unique": true
        },
        {
          "name": "goal_per_week",
          "displayName": "Goal per week",
          "type": "integer"
        },
        {
          "name": "check_ins",
          "displayName": "Check-ins",
          "type": "computed",
          "formula": "COUNT({{habit_log}})"
        }
      ]
    },
    {
      "name": "{{habit_log}}",
      "displayName": "Habit log",
      "columns": [
        {
          "name": "id",
          "type": "integer",
          "primaryKey": true
        },
        {
          "name": "date",
          "displayName": "Date",
          "type": "date",
          "nullable": false
        },
        {
          "name": "habit_id",
          "displayName": "Habit",
          "type": "reference",
          "references": "{{habits}}",
          "nullable": false
        },
        {
          "name": "note",
          "displayName": "Note",
          "type": "text"
        }
      ]
    },
    {
      "name": "{{measurements}}",
      "displayName": "Measurements",
      "columns": [
        {
          "name": "id",
          "type": "integer",
          "primaryKey": true
        },
        {
          "name": "date",
          "displayName": "Date",
          "type": "date",
          "nullable": false
        },
        {
          "name": "weight",
          "displayName": "Weight (kg)",
          "type": "float"
        },
        {
          "name": "sleep_hours",
          "displayName": "Sleep (hours)",
          "type": "float"
        },
        {
          "name": "mood",
          "displayName": "Mood (1–5)",
          "type": "integer"
        },
        {
          "name": "note",
          "displayName": "Note",
          "type": "text"
        }
      ]
    }
  ],
  "relations": [
    {
      "name": "{{habits}}_{{habit_log}}",
      "type": "1:N",
      "from": "{{habits}}",
      "to": "{{habit_log}}",
      "column": "habit_id"
    }
  ],
  "dashboards": [
    {
      "name": "Habits & health",
      "dashboard": {
        "description": "Goals, check-ins and how you feel",
        "dateRange": {
          "preset": "last-3-months"
        },
        "widgets": [
          {
            "id": "check-ins",
            "type": "kpi",
            "title": "Check-ins",
            "position": {
              "x": 0,
              "y": 0,
              "w": 3,
              "h": 2
            },
            "data": {
              "query": {
                "source": "{{habit_log}}",
                "measures": [
                  {
                    "name": "check_ins",
                    "fn": "count"
                  }
                ]
              },
              "dateColumn": "date"
            },
            "display": {
              "format": "integer",
              "compare": true,
              "higherIsBetter": true
            }
          },
          {
            "id": "weight",
            "type": "kpi",
            "title": "Weight",
            "position": {
              "x": 3,
              "y": 0,
              "w": 3,
              "h": 2
            },
            "data": {
              "query": {
                "source": "{{measurements}}",
                "measures": [
                  {
                    "name": "weight",
                    "formula": "LAST(weight, date)"
                  }
                ]
              },
              "dateColumn": "date"
            },
            "display": {
              "format": "number",
              "compare": true
            }
          },
          {
            "id": "sleep",
            "type": "kpi",
            "title": "Average sleep",
            "position": {
              "x": 6,
              "y": 0,
              "w": 3,
              "h": 2
            },
            "data": {
              "query": {
                "source": "{{measurements}}",
                "measures": [
                  {
                    "name": "sleep",
                    "fn": "avg",
                    "column": "sleep_hours"
                  }
                ]
              },
              "dateColumn": "date"
            },
            "display": {
              "format": "number",
              "compare": true,
              "higherIsBetter": true
            }
          },
          {
            "id": "mood",
            "type": "kpi",
            "title": "Average mood",
            "position": {
              "x": 9,
              "y": 0,
              "w": 3,
              "h": 2
            },
            "data": {
              "query": {
                "source": "{{measurements}}",
                "measures": [
                  {
                    "name": "mood",
                    "fn": "avg",
                    "column": "mood"
                  }
                ]
              },
              "dateColumn": "date"
            },
            "display": {
              "format": "number",
              "compare": true,
              "higherIsBetter": true
            }
          },
          {
            "id": "goals",
            "type": "target",
            "title": "This week's goals",
            "position": {
              "x": 0,
              "y": 2,
              "w": 5,
              "h": 5
            },
            "data": {
              "target": {
                "source": "{{habit_log}}",
                "value": "COUNT()",
                "date": "date",
                "group": "habit_id",
                "target": "goal_per_week",
                "per": "week",
                "period": "current",
                "kind": "goal",
                "format": "integer"
              }
            }
          },
          {
            "id": "check-ins-per-week",
            "type": "bar",
            "title": "Check-ins per week",
            "position": {
              "x": 5,
              "y": 2,
              "w": 7,
              "h": 5
            },
            "data": {
              "query": {
                "source": "{{habit_log}}",
                "groupBy": [
                  {
                    "column": "date",
                    "bucket": "week",
                    "as": "week"
                  },
                  {
                    "column": "habit_id"
                  }
                ],
                "measures": [
                  {
                    "name": "check_ins",
                    "fn": "count"
                  }
                ]
              },
              "dateColumn": "date"
            },
            "display": {
              "format": "integer"
            }
          },
          {
            "id": "weight-over-time",
            "type": "line",
            "title": "Weight",
            "position": {
              "x": 0,
              "y": 7,
              "w": 6,
              "h": 4
            },
            "data": {
              "query": {
                "source": "{{measurements}}",
                "groupBy": [
                  {
                    "column": "date",
                    "bucket": "week",
                    "as": "week"
                  }
                ],
                "measures": [
                  {
                    "name": "weight",
                    "fn": "avg",
                    "column": "weight"
                  }
                ]
              },
              "dateColumn": "date"
            },
            "display": {
              "format": "number",
              "yAxis": {
                "min": "auto"
              },
              "emptyPeriods": "connect"
            }
          },
          {
            "id": "sleep-over-time",
            "type": "line",
            "title": "Sleep and mood",
            "position": {
              "x": 6,
              "y": 7,
              "w": 6,
              "h": 4
            },
            "data": {
              "query": {
                "source": "{{measurements}}",
                "groupBy": [
                  {
                    "column": "date",
                    "bucket": "week",
                    "as": "week"
                  }
                ],
                "measures": [
                  {
                    "name": "sleep",
                    "fn": "avg",
                    "column": "sleep_hours"
                  },
                  {
                    "name": "mood",
                    "fn": "avg",
                    "column": "mood"
                  }
                ]
              },
              "dateColumn": "date"
            },
            "display": {
              "format": "number",
              "emptyPeriods": "connect"
            }
          }
        ]
      }
    }
  ],
  "forms": [
    {
      "name": "Check in",
      "form": {
        "table": "{{habit_log}}",
        "pinned": true,
        "fields": [
          {
            "column": "habit_id",
            "label": "Habit"
          },
          {
            "column": "date",
            "label": "Date",
            "default": {
              "kind": "today"
            }
          },
          {
            "column": "note",
            "label": "Note"
          }
        ]
      }
    },
    {
      "name": "Log measurement",
      "form": {
        "table": "{{measurements}}",
        "pinned": true,
        "fields": [
          {
            "column": "date",
            "label": "Date",
            "default": {
              "kind": "today"
            }
          },
          {
            "column": "weight",
            "label": "Weight (kg)"
          },
          {
            "column": "sleep_hours",
            "label": "Sleep (hours)"
          },
          {
            "column": "mood",
            "label": "Mood (1–5)"
          },
          {
            "section": "More"
          },
          {
            "column": "note",
            "label": "Note"
          }
        ]
      }
    }
  ],
